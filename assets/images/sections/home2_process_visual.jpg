    <filter id="shadow_Forensic_Tag_Audit" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#302521" flood-opacity="0.12"/>
    </filter>
  </defs>
  <rect width="800" height="800" fill="url(#grad_Forensic_Tag_Audit)"/>
